{
  "default_account": "personal",

  "accounts": {
    "personal": {
      "email": "you@example.com",
      "config_dir": "~/.claude-personal",
      "description": "Personal — catch-all for everything not matched by repo_rules"
    },
    "work": {
      "email": "you@work.example",
      "config_dir": "~/.claude-work",
      "description": "Rename this to your workspace (e.g. \"acme\"); add more accounts the same way"
    }
  },

  "repo_rules": [
    { "remote": "github.com/acme-org/", "account": "work" },
    { "remote": "gitlab.com/acme/", "account": "work" },
    { "match": "/acme-", "account": "work" }
  ]
}
