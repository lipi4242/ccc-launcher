#!/bin/bash
# ccc — Claude Code launcher with multi-account support
#
# Uses CLAUDE_CONFIG_DIR to run separate accounts side by side. Each account
# gets its own config dir, and with it its own Claude auth token, `gh` token,
# git identity and Wrangler/Cloudflare state.
#
# Usage:
#   ccc                Launch Claude Code on the account this repo maps to
#   ccc --telegram     Also enable the Telegram channel
#   ccc --force        Launch even if the logged-in email doesn't match
#   ccc --status       Show the account mapping for this repo
#   ccc --setup        Interactive login for every account in the config
#   ccc [any args]     Passed through to claude (--resume, -c, a prompt, …)
#
# Config: ~/.claude/account-guard.json
#   accounts         name → { email, config_dir, description }
#   repo_rules       ordered list; each rule is { account } plus ONE of:
#                      "remote" — substring of the origin remote URL (case-insensitive)
#                      "match"  — substring of the full cwd path
#                    The first rule that matches wins.
#   default_account  used when no rule matches. Omit it to fail loudly instead.
#
# The model is deliberately NOT set here. It belongs in each account's
# <config_dir>/settings.json (e.g. "model": "opus[1m]"), because a --model
# flag on the command line overrides that file — and passing a bare alias
# like `--model opus` silently drops the 1M context variant.

set -euo pipefail

GUARD_CONFIG="$HOME/.claude/account-guard.json"
EXTRA_FLAGS=()
FORCE=0

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
GOLD='\033[0;33m'
DIM='\033[0;90m'
NC='\033[0m'

# --- Handle ccc's own flags; everything else is passed through to claude ---
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --telegram) EXTRA_FLAGS+=(--channels plugin:telegram@claude-plugins-official) ;;
    --force)    FORCE=1 ;;
    *)          ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# --- Decide whether to use `--` before user args ---
# Add `--` ONLY when the user is passing a positional prompt (e.g. `ccc /your:command`),
# so the variadic `--channels` from EXTRA_FLAGS can't swallow it. SKIP `--` when the
# user is passing flags like `--resume`, `--continue`, `-c` — otherwise claude treats
# them as the prompt.
SEPARATOR=()
if [ "$#" -gt 0 ] && [[ "${1}" != -* ]]; then
  SEPARATOR=(--)
fi

ensure_account_gitconfig() {
  local config_dir="$1"
  local gitconfig="$config_dir/gitconfig"

  if [ -f "$gitconfig" ]; then
    return
  fi

  cat > "$gitconfig" << 'GITCFG'
# Auto-created by ccc launcher. Add per-account overrides below the include.
# Common examples:
#   [user]
#       email = you@work.example
#       signingkey = <fingerprint>
#   [core]
#       sshCommand = ssh -i ~/.ssh/work_ed25519
[include]
    path = ~/.gitconfig

# Force GitHub HTTPS auth through `gh` under GH_CONFIG_DIR.
# The empty helper clears shared helpers from ~/.gitconfig such as osxkeychain.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
GITCFG
}

# --- Config existence check ---
if [ ! -f "$GUARD_CONFIG" ]; then
  echo -e "${RED}✗${NC} No account-guard config at $GUARD_CONFIG"
  echo "  Copy account-guard.example.json from the ccc-launcher repo and fill in"
  echo "  your email(s) and repo rules, then re-run."
  exit 1
fi

# --- Setup mode ---
if [ "${1:-}" = "--setup" ]; then
  echo -e "${GOLD}Claude Code Multi-Account Setup${NC}"
  echo ""
  echo "This will log you into each account in its own config dir."
  echo "You only need to do this once per account."
  echo ""

  # Collect the list first. Looping directly over a pipe would make the
  # `read` prompts below consume the pipe instead of the terminal.
  ACCOUNT_LIST=$(CCC_GUARD="$GUARD_CONFIG" python3 - <<'PY'
import json, os
cfg = json.load(open(os.environ['CCC_GUARD']))
for name, acct in cfg.get('accounts', {}).items():
    email = acct.get('email')
    cd = acct.get('config_dir') or ''
    if not email or not cd:
        continue
    print('%s|%s|%s' % (name, email, os.path.expanduser(cd)))
PY
)

  while IFS='|' read -r name email cd; do
    [ -n "$name" ] || continue
    echo -e "${GOLD}→ $name ($email)${NC}"
    echo "    Config dir: $cd"
    mkdir -p "$cd"

    read -r -p "    Claude: press Enter to login (or 's' to skip): " choice < /dev/tty
    if [ "$choice" != "s" ]; then
      CLAUDE_CONFIG_DIR="$cd" claude auth login --email "$email" || true
    fi

    if command -v gh >/dev/null 2>&1; then
      read -r -p "    GitHub: press Enter to also run 'gh auth login' (or 's' to skip): " ghchoice < /dev/tty
      if [ "$ghchoice" != "s" ]; then
        mkdir -p "$cd/gh"
        ensure_account_gitconfig "$cd"
        GH_CONFIG_DIR="$cd/gh" gh auth login || true
        GH_CONFIG_DIR="$cd/gh" GIT_CONFIG_GLOBAL="$cd/gitconfig" gh auth setup-git || true
      fi
    else
      echo "    (gh CLI not installed — skipping GitHub login. Install: brew install gh)"
    fi
    echo ""
  done <<< "$ACCOUNT_LIST"

  echo -e "${GREEN}Setup complete!${NC} Use 'ccc' to launch Claude Code."
  echo "Each tmux pane can run a different account simultaneously."
  exit 0
fi

# --- Detect repo ---
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
CWD="$(pwd)"
if [ -n "$REPO_ROOT" ]; then
  REPO_NAME=$(basename "$REPO_ROOT")
  REPO_REMOTE=$(git remote get-url origin 2>/dev/null || echo "")
else
  REPO_NAME=$(basename "$CWD")
  REPO_REMOTE=""
  echo -e "${DIM}Not in a git repo — routing on path only.${NC}"
fi

# --- Look up the account for this repo ---
# Rules are matched against the origin remote URL and the full cwd path, so a
# git worktree resolves to the same account as its parent repo even when the
# directory is named something else.
ACCOUNT_INFO=$(
  CCC_GUARD="$GUARD_CONFIG" CCC_CWD="$CWD" CCC_REMOTE="$REPO_REMOTE" python3 - <<'PY'
import json, os, sys

try:
    cfg = json.load(open(os.environ['CCC_GUARD']))
except Exception as exc:
    sys.stderr.write("account-guard.json is not readable: %s\n" % exc)
    sys.exit(1)

cwd = os.environ['CCC_CWD']
remote = os.environ.get('CCC_REMOTE', '')
accounts = cfg.get('accounts', {})

# Match remote rules against both the raw URL and a slash-normalised copy, so
# one rule covers both remote forms:
#   https://github.com/Org/repo.git   → matches "github.com/Org/" as written
#   git@github.com:Org/repo.git       → matches it via the normalised copy
remote_forms = [remote.lower(), remote.replace(':', '/').lower()] if remote else []


def emit(status, name):
    acct = accounts.get(name, {})
    config_dir = acct.get('config_dir') or ''
    if config_dir:
        config_dir = os.path.expanduser(config_dir)
    print('|'.join([status, name, acct.get('email') or '', config_dir,
                    acct.get('description') or '']))


for rule in cfg.get('repo_rules', []):
    name = rule.get('account')
    if name not in accounts:
        sys.stderr.write("repo_rule points at unknown account %r\n" % name)
        sys.exit(1)
    if 'remote' in rule:
        needle = rule['remote'].lower()
        hit = any(needle in form for form in remote_forms)
    elif 'match' in rule:
        hit = rule['match'] in cwd
    else:
        sys.stderr.write("repo_rule needs a 'remote' or 'match' key: %r\n" % rule)
        sys.exit(1)
    if hit:
        emit('rule', name)
        sys.exit(0)

fallback = cfg.get('default_account')
if fallback and fallback in accounts:
    emit('default', fallback)
    sys.exit(0)

print('none||||')
PY
) || {
  echo -e "${RED}✗${NC} Could not read $GUARD_CONFIG (see error above)."
  exit 1
}

ACCT_SOURCE=$(echo "$ACCOUNT_INFO" | cut -d'|' -f1)
ACCT_TYPE=$(echo "$ACCOUNT_INFO" | cut -d'|' -f2)
ACCT_EMAIL=$(echo "$ACCOUNT_INFO" | cut -d'|' -f3)
ACCT_CONFIG_DIR=$(echo "$ACCOUNT_INFO" | cut -d'|' -f4)
ACCT_DESC=$(echo "$ACCOUNT_INFO" | cut -d'|' -f5-)

# --- Status mode ---
if [ "${1:-}" = "--status" ]; then
  echo -e "${GOLD}Repo:${NC}    $REPO_NAME"
  echo -e "${GOLD}Remote:${NC}  ${REPO_REMOTE:-(none)}"
  if [ "$ACCT_SOURCE" = "none" ]; then
    echo -e "${GOLD}Account:${NC} unknown — no matching rule and no default_account"
    exit 1
  fi
  echo -e "${GOLD}Account:${NC} $ACCT_TYPE ($ACCT_EMAIL) via $ACCT_SOURCE"
  echo -e "${GOLD}Config:${NC}  $ACCT_CONFIG_DIR"
  echo -e "${GOLD}Desc:${NC}    $ACCT_DESC"
  if [ -n "$ACCT_CONFIG_DIR" ]; then
    STATUS_EMAIL=$(CLAUDE_CONFIG_DIR="$ACCT_CONFIG_DIR" claude auth status --json 2>/dev/null \
      | python3 -c "import sys,json; print(json.load(sys.stdin).get('email') or '')" 2>/dev/null \
      || echo "")
    if [ -n "$STATUS_EMAIL" ]; then
      echo -e "${GOLD}Login:${NC}   $STATUS_EMAIL"
    else
      echo -e "${GOLD}Login:${NC}   ${RED}not logged in${NC} — run: ccc --setup"
    fi
  fi
  exit 0
fi

# --- No rule matched and no default configured → refuse rather than guess ---
if [ "$ACCT_SOURCE" = "none" ]; then
  echo -e "${RED}✗${NC} Repo '${REPO_NAME}' matches no repo_rule, and no default_account is set."
  echo "  Add a repo_rule to $GUARD_CONFIG, or set 'default_account' to a named account."
  exit 1
fi

if [ -z "$ACCT_CONFIG_DIR" ]; then
  echo -e "${RED}✗${NC} Account '$ACCT_TYPE' has no config_dir in $GUARD_CONFIG."
  exit 1
fi

# --- Check we're logged into the right account ---
CURRENT_EMAIL=$(CLAUDE_CONFIG_DIR="$ACCT_CONFIG_DIR" claude auth status --json 2>/dev/null \
  | python3 -c "import sys,json; print(json.load(sys.stdin).get('email') or '')" 2>/dev/null \
  || echo "")

if [ -z "$CURRENT_EMAIL" ]; then
  echo -e "${RED}✗${NC} Not logged into the $ACCT_TYPE account yet."
  echo "  Run: ccc --setup"
  echo "  Or:  CLAUDE_CONFIG_DIR=$ACCT_CONFIG_DIR claude auth login --email $ACCT_EMAIL"
  exit 1
fi

if [ -n "$ACCT_EMAIL" ] && [ "$CURRENT_EMAIL" != "$ACCT_EMAIL" ]; then
  echo -e "${RED}🚫 ACCOUNT MISMATCH${NC}"
  echo "  Repo:     $REPO_NAME → needs $ACCT_TYPE"
  echo "  Expected: $ACCT_EMAIL"
  echo "  Got:      $CURRENT_EMAIL"
  echo ""
  echo "  Fix: CLAUDE_CONFIG_DIR=$ACCT_CONFIG_DIR claude auth login --email $ACCT_EMAIL"
  if [ "$FORCE" -ne 1 ]; then
    echo "  Or re-run with --force to launch anyway."
    exit 1
  fi
  echo -e "  ${GOLD}--force given — launching anyway.${NC}"
fi

if [ "$ACCT_SOURCE" = "default" ]; then
  echo -e "${GREEN}✓${NC} $REPO_NAME → $ACCT_TYPE ($CURRENT_EMAIL) ${DIM}[default]${NC}"
else
  echo -e "${GREEN}✓${NC} $REPO_NAME → $ACCT_TYPE ($CURRENT_EMAIL)"
fi
export CLAUDE_CONFIG_DIR="$ACCT_CONFIG_DIR"

# --- Per-account Wrangler config dir (for `wrangler login` OAuth credentials) ---
# Wrangler v4 stores auth in XDG config on macOS (~/Library/Preferences/.wrangler
# by default) and ignores WRANGLER_HOME. Point XDG_CONFIG_HOME at an account-scoped
# directory so `wrangler login` writes separate OAuth state per account.
# Keep WRANGLER_HOME for older Wrangler v1-style tooling that may still honor it.
mkdir -p "$ACCT_CONFIG_DIR/wrangler"
mkdir -p "$ACCT_CONFIG_DIR/xdg"
export WRANGLER_HOME="$ACCT_CONFIG_DIR/wrangler"
export XDG_CONFIG_HOME="$ACCT_CONFIG_DIR/xdg"
if [ -d "$HOME/.wrangler" ]; then
  echo -e "${GOLD}⚠${NC} Legacy ~/.wrangler exists; modern Wrangler prefers it over XDG_CONFIG_HOME."
  echo "  Move ~/.wrangler aside or use $ACCT_CONFIG_DIR/cloudflare.env with CLOUDFLARE_API_TOKEN for clean isolation."
fi

# --- Per-account GitHub CLI config dir ---
# `gh` honors GH_CONFIG_DIR the same way `claude` honors CLAUDE_CONFIG_DIR.
# Each account stores its own auth token + host config under its dir.
# Pair with the per-account gitconfig below so HTTPS push uses GH_CONFIG_DIR
# instead of a shared helper such as osxkeychain.
mkdir -p "$ACCT_CONFIG_DIR/gh"
export GH_CONFIG_DIR="$ACCT_CONFIG_DIR/gh"

# --- Per-account git config (user.email, signing key, credential helper) ---
# Without this, `git config --global` is shared across accounts and your
# commits get signed by the wrong identity. The per-account file includes
# the user's normal ~/.gitconfig as a base so aliases + global prefs still
# apply; users add per-account overrides (user.email, core.sshCommand for
# account-specific SSH keys, etc.) below the include stanza.
GITCONFIG="$ACCT_CONFIG_DIR/gitconfig"
ensure_account_gitconfig "$ACCT_CONFIG_DIR"
export GIT_CONFIG_GLOBAL="$GITCONFIG"

# --- Source per-account Cloudflare env if present ---
# File format (one var per line):
#   CLOUDFLARE_API_TOKEN=...        ← optional; if set, overrides OAuth
#   CLOUDFLARE_ACCOUNT_ID=...       ← recommended; used by wrangler when account is ambiguous
# If CLOUDFLARE_API_TOKEN is empty/missing, wrangler falls back to OAuth via XDG_CONFIG_HOME.
if [ -f "$ACCT_CONFIG_DIR/cloudflare.env" ]; then
  set -a
  # shellcheck source=/dev/null
  source "$ACCT_CONFIG_DIR/cloudflare.env"
  set +a
  if [ -n "${CLOUDFLARE_API_TOKEN:-}" ]; then
    echo -e "${GREEN}✓${NC} Cloudflare API token loaded for $ACCT_TYPE"
  else
    echo -e "${GREEN}✓${NC} Cloudflare account-id loaded for $ACCT_TYPE (OAuth via XDG_CONFIG_HOME)"
  fi
fi

exec claude --dangerously-skip-permissions ${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"} ${SEPARATOR[@]+"${SEPARATOR[@]}"} "$@"
